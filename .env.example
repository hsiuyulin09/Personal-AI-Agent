# LLM API key
# Groq provider：configs/llm_config.yaml provider 設為 groq 時使用
groq_api_key=

# OpenAI 線上付費 API：configs/llm_config.yaml provider 設為 openai 時使用
OPENAI_API_KEY=


# PostgreSQL
# 將三處 YOUR_LOCAL_PASSWORD 替換成自己的本機密碼
POSTGRES_DB=personal_ai_agent
POSTGRES_USER=personal_ai_agent
POSTGRES_PASSWORD=YOUR_LOCAL_PASSWORD
POSTGRES_PORT=5432

POSTGRES_DSN=postgresql://personal_ai_agent:YOUR_LOCAL_PASSWORD@localhost:5432/personal_ai_agent
POSTGRES_TEST_DSN=postgresql://personal_ai_agent:YOUR_LOCAL_PASSWORD@localhost:5432/personal_ai_agent_test
